@page
@model NewEmployeeModel
@{
ViewData["Title"] = "New Employee";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - FaceCheck</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            position: relative;
            color: #e0e0e0;
        }

        body::before {
            content: '';
            position: fixed;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(circle at 20% 50%, rgba(0, 255, 255, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(138, 43, 226, 0.08) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        .container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 2.5rem 3rem;
            flex: 1;
        }

        header {
            text-align: center;
            padding: 1rem 0 2rem;
            margin-bottom: 2rem;
        }

        h1 {
            font-size: 2rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 0.5rem;
            letter-spacing: -0.5px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #b0b0b0;
            text-decoration: none;
            font-size: 0.9rem;
            padding: 0.75rem 1.25rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            transition: all 0.2s ease;
            background: rgba(255, 255, 255, 0.05);
            margin-bottom: 2rem;
            font-weight: 500;
        }

        .back-button:hover {
            border-color: rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.08);
            transform: translateX(-3px);
            color: #ffffff;
        }

        .main-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .column {
            background: rgba(20, 20, 35, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 2.5rem;
            transition: all 0.2s ease;
        }

        .column:hover {
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        .column-title {
            font-size: 1.25rem;
            color: #ffffff;
            margin-bottom: 1.5rem;
            text-align: left;
            font-weight: 600;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 1rem;
        }

        /* --- Camera Section --- */
        .detection-frame {
            width: 100%;
            aspect-ratio: 4/3;
            background: rgba(255, 255, 255, 0.03);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            transition: border-color 0.2s ease;
        }

        .detection-frame.camera-active {
            border-color: rgba(0, 255, 255, 0.4);
        }

        .start-camera-btn {
            padding: 1.25rem 2rem;
            font-size: 1rem;
            color: #ffffff;
            background: rgba(0, 255, 255, 0.15);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
        }

        .start-camera-btn:hover {
            background: rgba(0, 255, 255, 0.25);
            border-color: rgba(0, 255, 255, 0.5);
            transform: translateY(-2px);
        }

        #videoElement {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
            transform: scaleX(-1); /* miroir naturel */
        }

        #videoElement.active {
            display: block;
        }

        .camera-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 55%;
            height: 72%;
            border: 2px solid rgba(0, 255, 255, 0.6);
            border-radius: 50% 50% 45% 45%;
            pointer-events: none;
            display: none;
        }

        .camera-overlay.active {
            display: block;
        }

        .capture-flash {
            position: absolute;
            inset: 0;
            background: white;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.05s ease;
            border-radius: 12px;
        }

        .capture-flash.active {
            opacity: 0.6;
        }

        /* --- Capture Controls --- */
        .capture-controls {
            display: none;
            align-items: center;
            justify-content: space-between;
            margin-top: 1rem;
            gap: 1rem;
        }

        .capture-controls.visible {
            display: flex;
        }

        .capture-progress {
            font-size: 1rem;
            font-weight: 700;
            color: #00ffff;
            min-width: 80px;
        }

        .capture-progress span {
            font-size: 1.5rem;
        }

        .btn-capture {
            flex: 1;
            padding: 0.85rem 1.25rem;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: rgba(0, 255, 255, 0.15);
            color: #00ffff;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .btn-capture:hover:not(:disabled) {
            background: rgba(0, 255, 255, 0.25);
            border-color: rgba(0, 255, 255, 0.5);
            transform: translateY(-1px);
        }

        .btn-capture:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .btn-capture.capturing {
            background: rgba(255, 200, 0, 0.15);
            color: #ffc800;
            border-color: rgba(255, 200, 0, 0.3);
        }

        .btn-capture.done {
            background: rgba(74, 222, 128, 0.15);
            color: #4ade80;
            border-color: rgba(74, 222, 128, 0.3);
        }

        /* --- Photo Strip --- */
        .photo-strip {
            display: flex;
            gap: 6px;
            margin-top: 0.85rem;
            overflow-x: auto;
            padding-bottom: 4px;
            min-height: 56px;
            align-items: center;
        }

        .photo-strip::-webkit-scrollbar {
            height: 4px;
        }

        .photo-strip::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.05);
            border-radius: 2px;
        }

        .photo-strip::-webkit-scrollbar-thumb {
            background: rgba(0,255,255,0.3);
            border-radius: 2px;
        }

        .capture-thumb {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid rgba(0, 255, 255, 0.3);
            flex-shrink: 0;
            transform: scaleX(-1);
        }

        .strip-placeholder {
            display: flex;
            gap: 6px;
        }

        .strip-slot {
            width: 50px;
            height: 50px;
            border-radius: 6px;
            border: 1px dashed rgba(255, 255, 255, 0.15);
            flex-shrink: 0;
        }

        /* --- Form --- */
        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            color: #b0b0b0;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 0.85rem 1rem;
            font-size: 0.95rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #ffffff;
            transition: all 0.2s ease;
            font-weight: 500;
        }

        input[type="text"]::placeholder,
        input[type="email"]::placeholder,
        input[type="password"]::placeholder {
            color: #606060;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus {
            outline: none;
            border-color: rgba(0, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 3px rgba(0, 255, 255, 0.1);
        }

        .button-group {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn {
            flex: 1;
            padding: 0.95rem 1.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-register {
            background: rgba(0, 255, 255, 0.15);
            color: #00ffff;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .btn-register:hover:not(:disabled) {
            transform: translateY(-2px);
            background: rgba(0, 255, 255, 0.25);
            border-color: rgba(0, 255, 255, 0.5);
        }

        .btn-register:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .btn-cancel {
            background: rgba(255, 255, 255, 0.05);
            color: #b0b0b0;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.15);
            color: #ffffff;
        }

        /* --- Result Popup --- */
        .result-popup {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            background: rgba(10, 10, 25, 0.95);
            color: #ffffff;
            padding: 2rem 3rem;
            border-radius: 16px;
            text-align: center;
            z-index: 1000;
            transition: transform 0.3s ease, opacity 0.3s ease;
            opacity: 0;
            min-width: 300px;
            border: 1px solid rgba(0, 255, 255, 0.2);
            box-shadow: 0 8px 32px rgba(0, 255, 255, 0.15);
        }

        .result-popup.active {
            transform: translate(-50%, -50%) scale(1);
            opacity: 1;
        }

        .result-message {
            font-size: 1.1rem;
            font-weight: 600;
            margin-top: 1rem;
        }

        .result-subtext {
            font-size: 0.85rem;
            color: #808080;
            margin-top: 0.5rem;
        }

        .result-icon {
            width: 50px;
            height: 50px;
            stroke: #00ffff;
            stroke-width: 2;
            fill: none;
        }

        footer {
            margin-top: auto;
            padding: 2rem;
            text-align: center;
            color: #606060;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
<div class="container">

    <header>
        <h1>Register New Employee</h1>
    </header>

    <a href="#" class="back-button" onclick="goBack()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
    </a>

    <form id="employeeForm" method="post">
        @Html.AntiForgeryToken()

        <div class="main-content">

            <!-- Colonne gauche : caméra -->
            <div class="column">
                <h2 class="column-title">Photos du visage <small style="color:#606060;font-size:0.8rem;font-weight:400">10 / 10 requises</small></h2>

                <div class="detection-frame" id="cameraFrame">
                    <button type="button" class="start-camera-btn" id="startCameraBtn" onclick="startCamera()">
                        Démarrer la caméra
                    </button>
                    <video id="videoElement" autoplay playsinline></video>
                    <div class="camera-overlay" id="cameraOverlay"></div>
                    <div class="capture-flash" id="captureFlash"></div>
                </div>

                <div class="capture-controls" id="captureControls">
                    <div class="capture-progress">
                        <span id="photoCount">0</span>/10
                    </div>
                    <button type="button" class="btn-capture" id="captureBtn" onclick="startCapture()">
                        Capturer 10 photos
                    </button>
                </div>

                <div class="photo-strip" id="photoStrip">
                    <div class="strip-placeholder" id="stripPlaceholder">
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                        <div class="strip-slot"></div>
                    </div>
                </div>

                <canvas id="captureCanvas" style="display:none"></canvas>
            </div>

            <!-- Colonne droite : informations employé -->
            <div class="column">
                <h2 class="column-title">Employee Information</h2>

                <div class="form-group">
                    <label for="firstName">First Name</label>
                    <input type="text" id="firstName" name="firstName" required placeholder="Enter first name">
                </div>

                <div class="form-group">
                    <label for="lastName">Last Name</label>
                    <input type="text" id="lastName" name="lastName" required placeholder="Enter last name">
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required placeholder="Enter email address">
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required placeholder="Enter password">
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="Confirm password">
                </div>

                <div class="button-group">
                    <button type="submit" class="btn btn-register" id="registerBtn" disabled>Register</button>
                    <button type="button" class="btn btn-cancel" onclick="cancelRegistration()">Cancel</button>
                </div>

                <p id="registerHint" style="font-size:0.8rem;color:#606060;margin-top:0.75rem;text-align:center">
                    Capturez 10 photos pour activer l'enregistrement
                </p>
            </div>
        </div>
    </form>
</div>

<!-- Popup résultat -->
<div class="result-popup" id="resultPopup">
    <svg class="result-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path id="resultIcon"></path>
    </svg>
    <div class="result-message" id="resultMessage"></div>
    <div class="result-subtext" id="resultSubtext"></div>
</div>

<footer>
    &copy; 2025 Face Recognition System. All rights reserved.
</footer>

<script>
    const TOTAL_PHOTOS = 10;
    let capturedPhotos = [];
    let cameraStream = null;
    let isCapturing = false;

    // ── Caméra ──────────────────────────────────────────────────────────────
    async function startCamera() {
        try {
            cameraStream = await navigator.mediaDevices.getUserMedia({
                video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' }
            });
            const video = document.getElementById('videoElement');
            video.srcObject = cameraStream;
            video.classList.add('active');
            document.getElementById('startCameraBtn').style.display = 'none';
            document.getElementById('cameraOverlay').classList.add('active');
            document.getElementById('cameraFrame').classList.add('camera-active');
            document.getElementById('captureControls').classList.add('visible');
            document.getElementById('captureBtn').disabled = false;
        } catch (err) {
            alert("Impossible d'accéder à la caméra : " + err.message);
        }
    }

    // ── Capture automatique 10 photos ───────────────────────────────────────
    async function startCapture() {
        if (isCapturing) return;
        isCapturing = true;

        const video  = document.getElementById('videoElement');
        const canvas = document.getElementById('captureCanvas');
        const ctx    = canvas.getContext('2d');
        const btn    = document.getElementById('captureBtn');
        const countEl = document.getElementById('photoCount');
        const strip  = document.getElementById('photoStrip');

        canvas.width  = video.videoWidth  || 640;
        canvas.height = video.videoHeight || 480;

        // Réinitialiser
        capturedPhotos = [];
        strip.innerHTML = '';
        countEl.textContent = '0';
        btn.disabled = true;
        btn.classList.add('capturing');
        btn.textContent = 'Capture en cours…';
        updateRegisterButton();

        for (let i = 0; i < TOTAL_PHOTOS; i++) {
            // Flash
            const flash = document.getElementById('captureFlash');
            flash.classList.add('active');
            setTimeout(() => flash.classList.remove('active'), 120);

            // Capture (le miroir CSS est pour l'affichage, on capture l'image originale)
            ctx.save();
            ctx.scale(-1, 1);
            ctx.drawImage(video, -canvas.width, 0);
            ctx.restore();

            const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
            capturedPhotos.push(dataUrl);

            // Miniature
            const img = document.createElement('img');
            img.src = dataUrl;
            img.className = 'capture-thumb';
            strip.appendChild(img);

            countEl.textContent = i + 1;

            if (i < TOTAL_PHOTOS - 1) {
                await sleep(700);
            }
        }

        btn.classList.remove('capturing');
        btn.classList.add('done');
        btn.textContent = 'Recapturer';
        btn.disabled = false;
        isCapturing = false;
        updateRegisterButton();
    }

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function updateRegisterButton() {
        const registerBtn  = document.getElementById('registerBtn');
        const registerHint = document.getElementById('registerHint');
        const ready = capturedPhotos.length === TOTAL_PHOTOS;
        registerBtn.disabled = !ready;
        registerHint.style.display = ready ? 'none' : 'block';
    }

    // ── Soumission du formulaire ─────────────────────────────────────────────
    document.getElementById('employeeForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        if (capturedPhotos.length !== TOTAL_PHOTOS) {
            alert(`Veuillez capturer ${TOTAL_PHOTOS} photos avant d'enregistrer.`);
            return;
        }

        const password        = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        if (password !== confirmPassword) {
            alert('Les mots de passe ne correspondent pas !');
            return;
        }

        const form     = document.getElementById('employeeForm');
        const formData = new FormData(form);

        // Ajouter les photos base64
        capturedPhotos.forEach(photo => {
            formData.append('faceImagesBase64', photo);
        });

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const registerBtn = document.getElementById('registerBtn');
        registerBtn.disabled = true;
        registerBtn.textContent = 'Enregistrement…';

        try {
            const response = await fetch('', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: formData
            });

            if (response.ok) {
                showResult(true,
                    'Employé enregistré !',
                    'Entraînement du modèle lancé en arrière-plan…');
                resetForm();
            } else {
                const error = await response.text();
                alert('Erreur : ' + error);
                registerBtn.disabled = false;
                registerBtn.textContent = 'Register';
            }
        } catch (err) {
            alert('Erreur réseau : ' + err.message);
            registerBtn.disabled = false;
            registerBtn.textContent = 'Register';
        }
    });

    // ── Réinitialisation ─────────────────────────────────────────────────────
    function resetForm() {
        document.getElementById('employeeForm').reset();
        capturedPhotos = [];
        document.getElementById('photoStrip').innerHTML = '';
        document.getElementById('photoCount').textContent = '0';
        document.getElementById('captureBtn').classList.remove('done');
        document.getElementById('captureBtn').textContent = 'Capturer 10 photos';
        updateRegisterButton();

        if (cameraStream) {
            cameraStream.getTracks().forEach(t => t.stop());
            cameraStream = null;
        }
        document.getElementById('videoElement').classList.remove('active');
        document.getElementById('startCameraBtn').style.display = '';
        document.getElementById('cameraOverlay').classList.remove('active');
        document.getElementById('cameraFrame').classList.remove('camera-active');
        document.getElementById('captureControls').classList.remove('visible');
    }

    function cancelRegistration() {
        if (confirm('Annuler l\'enregistrement ?')) {
            resetForm();
        }
    }

    function goBack() {
        window.history.back();
    }

    // ── Popup résultat ───────────────────────────────────────────────────────
    function showResult(success, message, subtext) {
        const popup    = document.getElementById('resultPopup');
        const msgEl    = document.getElementById('resultMessage');
        const subtextEl = document.getElementById('resultSubtext');
        const iconPath = document.getElementById('resultIcon');

        msgEl.textContent    = message || (success ? 'Succès !' : 'Erreur !');
        subtextEl.textContent = subtext || '';

        if (success) {
            iconPath.setAttribute('d', 'M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17');
            iconPath.closest('svg').style.stroke = '#4ade80';
        } else {
            iconPath.setAttribute('d', 'M18 6L6 18M6 6l12 12');
            iconPath.closest('svg').style.stroke = '#f87171';
        }

        popup.classList.add('active');
        setTimeout(() => popup.classList.remove('active'), 4000);
    }
</script>

</body>

</html>
