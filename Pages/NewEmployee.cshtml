@page
@model NewEmployeeModel
@{
    ViewData["Title"] = "New Employee";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - FaceCheck</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            position: relative;
            color: #e0e0e0;
        }

        body::before {
            content: '';
            position: fixed;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(circle at 20% 50%, rgba(0, 255, 255, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(138, 43, 226, 0.08) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        .container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 2.5rem 3rem;
            flex: 1;
        }

        header {
            text-align: center;
            padding: 1rem 0 2rem;
            margin-bottom: 2rem;
        }

        h1 {
            font-size: 2rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 0.5rem;
            letter-spacing: -0.5px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #b0b0b0;
            text-decoration: none;
            font-size: 0.9rem;
            padding: 0.75rem 1.25rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            transition: all 0.2s ease;
            background: rgba(255, 255, 255, 0.05);
            margin-bottom: 2rem;
            font-weight: 500;
        }

        .back-button:hover {
            border-color: rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.08);
            transform: translateX(-3px);
            color: #ffffff;
        }

        .main-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .column {
            background: rgba(20, 20, 35, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 2.5rem;
            transition: all 0.2s ease;
        }

        .column:hover {
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        .column-title {
            font-size: 1.25rem;
            color: #ffffff;
            margin-bottom: 1.5rem;
            text-align: left;
            font-weight: 600;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 1rem;
        }

        .detection-frame {
            width: 100%;
            aspect-ratio: 4/3;
            background: rgba(255, 255, 255, 0.03);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            transition: all 0.2s ease;
        }

        .detection-frame:hover {
            border-color: rgba(0, 255, 255, 0.3);
        }

        .start-camera-btn {
            padding: 1.5rem 2.5rem;
            font-size: 1rem;
            color: #ffffff;
            background: rgba(0, 255, 255, 0.15);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
        }

        .start-camera-btn:hover {
            background: rgba(0, 255, 255, 0.25);
            border-color: rgba(0, 255, 255, 0.5);
            transform: translateY(-2px);
        }

        .start-camera-btn:active {
            transform: translateY(0);
        }

        #videoElement {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

        #videoElement.active {
            display: block;
        }

        .camera-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60%;
            height: 70%;
            border: 2px solid rgba(0, 255, 255, 0.6);
            border-radius: 12px;
            pointer-events: none;
        }

        .camera-overlay::before,
        .camera-overlay::after {
            content: '';
            position: absolute;
            width: 25px;
            height: 25px;
            border: 2px solid #00ffff;
        }

        .camera-overlay::before {
            top: -2px;
            left: -2px;
            border-right: none;
            border-bottom: none;
        }

        .camera-overlay::after {
            top: -2px;
            right: -2px;
            border-left: none;
            border-bottom: none;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            color: #b0b0b0;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

        input[type="text"],
        input[type="email"] {
            width: 100%;
            padding: 0.85rem 1rem;
            font-size: 0.95rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #ffffff;
            transition: all 0.2s ease;
            font-weight: 500;
        }

        input[type="text"]::placeholder,
        input[type="email"]::placeholder {
            color: #606060;
        }

        input[type="text"]:focus,
        input[type="email"]:focus {
            outline: none;
            border-color: rgba(0, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 3px rgba(0, 255, 255, 0.1);
        }

        .button-group {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn {
            flex: 1;
            padding: 0.95rem 1.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-register {
            background: rgba(0, 255, 255, 0.15);
            color: #00ffff;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .btn-register:hover {
            transform: translateY(-2px);
            background: rgba(0, 255, 255, 0.25);
            border-color: rgba(0, 255, 255, 0.5);
        }

        .btn-register:active {
            transform: translateY(0);
        }

        .btn-cancel {
            background: rgba(255, 255, 255, 0.05);
            color: #b0b0b0;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.15);
            color: #ffffff;
        }

        .btn-cancel:active {
            transform: translateY(0);
        }

        .camera-status {
            text-align: center;
            margin-top: 1rem;
            color: #606060;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .camera-status.active {
            color: #4ade80;
            font-weight: 600;
        }

        footer {
            margin-top: auto;
            padding: 2rem;
            text-align: center;
            color: #606060;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <div class="container">

        <header>
            <h1>Register New Employee</h1>
        </header>

        <a href="#" class="back-button" onclick="goBack()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Back
        </a>

        <div class="main-content">
            <div class="form-group">
                <label for="faceFile">Upload Face Image</label>
                <input type="file" id="faceFile" name="FaceFile" accept="image/*" required>
            </div>

            <div class="column">
                <h2 class="column-title">Employee Information</h2>
                <form id="employeeForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="firstName">First Name</label>
                        <input type="text" id="firstName" name="firstName" required placeholder="Enter first name">
                    </div>

                    <div class="form-group">
                        <label for="lastName">Last Name</label>
                        <input type="text" id="lastName" name="lastName" required placeholder="Enter last name">
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required placeholder="Enter email address">
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-register">Register</button>
                        <button type="button" class="btn btn-cancel" onclick="cancelRegistration()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <footer>
        &copy; 2025 Face Recognition System. All rights reserved.
    </footer>

    <script>
        let stream = null;
        let cameraActive = false;

        const startCameraBtn = document.getElementById('startCameraBtn');
        const videoElement = document.getElementById('videoElement');
        const cameraStatus = document.getElementById('cameraStatus');
        const cameraOverlay = document.getElementById('cameraOverlay');

        startCameraBtn.addEventListener('click', async () => {
            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        width: { ideal: 1280 },
                        height: { ideal: 720 },
                        facingMode: 'user'
                    }
                });

                videoElement.srcObject = stream;
                videoElement.classList.add('active');
                startCameraBtn.style.display = 'none';
                cameraOverlay.style.display = 'block';
                cameraStatus.textContent = 'Camera: Active';
                cameraStatus.classList.add('active');
                cameraActive = true;
            } catch (error) {
                console.error('Error accessing camera:', error);
                alert('Unable to access camera. Please check permissions.');
            }
        });

        document.getElementById('employeeForm').addEventListener('submit', (e) => {
            e.preventDefault();

            if (!cameraActive) {
                alert('Please activate the camera to capture face data before registering.');
                return;
            }

            const formData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                faceData: 'captured' // Placeholder for actual face data
            };

            console.log('Registering employee:', formData);
            alert('Employee registered successfully!\n\nName: ' + formData.firstName + ' ' + formData.lastName + '\nEmail: ' + formData.email);

            // Reset form and camera
            document.getElementById('employeeForm').reset();
        });

        function cancelRegistration() {
            if (confirm('Are you sure you want to cancel? All data will be lost.')) {
                document.getElementById('employeeForm').reset();
                // window.location.href = 'index.html'; // Navigate back
            }
        }


        function goBack() {
            stopCamera();
            // window.location.href = 'index.html'; // Navigate back to home
            window.history.back();
        }
    </script>
</body>

</html>