@page
@model EmployeeListModel
@{
    ViewData["Title"] = "Employee List";
    
    // Helper method to generate page URLs with search parameter
    string GetPageUrl(int pageNumber)
    {
        if (string.IsNullOrEmpty(Model.SearchTerm))
        {
            return Url.Page("/EmployeeList", new { pageNumber });
        }
        return Url.Page("/EmployeeList", new { pageNumber, search = Model.SearchTerm });
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - FaceCheck</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);
            min-height: 100vh;
            color: #e0e0e0;
        }

        body::before {
            content: '';
            position: fixed;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(circle at 20% 50%, rgba(0, 255, 255, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(138, 43, 226, 0.08) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        .container {
            position: relative;
            z-index: 1;
            max-width: 1600px;
            margin: 0 auto;
            padding: 2.5rem 3rem;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 3rem;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.25rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #b0b0b0;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.15);
            color: #ffffff;
        }

        h1 {
            font-size: 2rem;
            font-weight: 600;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .controls-section {
            background: rgba(20, 20, 35, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 1.75rem;
            margin-bottom: 1.5rem;
        }

        .controls-row {
            display: flex;
            gap: 1rem;
            align-items: center;
            justify-content: space-between;
        }

        .search-container {
            flex: 1;
            max-width: 400px;
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            stroke: #606060;
            pointer-events: none;
        }

        .search-input {
            width: 100%;
            padding: 0.875rem 1rem 0.875rem 3rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: #ffffff;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .search-input:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(0, 255, 255, 0.4);
        }

        .search-input::placeholder {
            color: #606060;
        }

        .button-group {
            display: flex;
            gap: 0.75rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.875rem 1.5rem;
            font-size: 0.9rem;
            font-weight: 500;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-primary {
            background: rgba(0, 255, 255, 0.15);
            color: #00ffff;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .btn-primary:hover {
            background: rgba(0, 255, 255, 0.25);
            border-color: rgba(0, 255, 255, 0.5);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: #b0b0b0;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
        }

        .btn svg {
            width: 18px;
            height: 18px;
        }

        .table-wrapper {
            background: rgba(20, 20, 35, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        th {
            padding: 1.125rem 1.5rem;
            text-align: left;
            font-size: 0.8rem;
            font-weight: 600;
            color: #909090;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        td {
            padding: 1.25rem 1.5rem;
            font-size: 0.95rem;
            color: #d0d0d0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        tbody tr {
            transition: background-color 0.15s ease;
        }

        tbody tr:hover {
            background: rgba(255, 255, 255, 0.03);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            background: linear-gradient(135deg, rgba(0, 255, 255, 0.2), rgba(0, 180, 255, 0.3));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.875rem;
            color: #00ffff;
            border: 1px solid rgba(0, 255, 255, 0.2);
        }

        .employee-name {
            font-weight: 500;
            color: #ffffff;
        }

        .employee-email {
            color: #909090;
            font-size: 0.875rem;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .badge-active {
            background: rgba(34, 197, 94, 0.15);
            color: #4ade80;
            border: 1px solid rgba(34, 197, 94, 0.2);
        }

        .badge-inactive {
            background: rgba(251, 146, 60, 0.15);
            color: #fb923c;
            border: 1px solid rgba(251, 146, 60, 0.2);
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .btn-delete {
            padding: 0.5rem 1rem;
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-delete:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.3);
        }

        .btn-reactivate {
            padding: 0.5rem 1rem;
            background: rgba(34, 197, 94, 0.1);
            color: #4ade80;
            border: 1px solid rgba(34, 197, 94, 0.2);
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-reactivate:hover {
            background: rgba(34, 197, 94, 0.2);
            border-color: rgba(34, 197, 94, 0.3);
        }

        .pagination-wrapper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 1.5rem;
            padding: 1.5rem;
            background: rgba(20, 20, 35, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
        }

        .pagination-info {
            color: #909090;
            font-size: 0.9rem;
        }

        .pagination-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .page-btn {
            min-width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 0.75rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #b0b0b0;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .page-btn:hover:not(:disabled):not(.active) {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
        }

        .page-btn.active {
            background: rgba(0, 255, 255, 0.15);
            border-color: rgba(0, 255, 255, 0.3);
            color: #00ffff;
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .empty-state {
            padding: 5rem 2rem;
            text-align: center;
        }

        .empty-state svg {
            width: 64px;
            height: 64px;
            stroke: #404040;
            margin-bottom: 1.5rem;
        }

        .empty-state h3 {
            color: #808080;
            font-size: 1.25rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            color: #606060;
            font-size: 0.95rem;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <a href="#" class="back-btn" onclick="goBack()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
                Back
            </a>
            <h1>Employee Management</h1>
            <div style="width: 80px;"></div>
        </div>

        <div class="controls-section">
            <div class="controls-row">
                <form method="get" style="display: flex; gap: 1rem; align-items: center; flex: 1; max-width: 400px;">
                    <div class="search-container" style="flex: 1;">
                        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <path d="M21 21l-4.35-4.35" />
                        </svg>
                        <input type="text" class="search-input" id="searchInput" name="search" placeholder="Search employees..." value="@Model.SearchTerm">
                    </div>
                    <button type="submit" style="padding: 0.875rem 1.5rem; background: rgba(0, 255, 255, 0.15); color: #00ffff; border: 1px solid rgba(0, 255, 255, 0.3); border-radius: 10px; cursor: pointer; font-size: 0.9rem; font-weight: 500; transition: all 0.2s ease;">
                        Search
                    </button>
                </form>
                <div class="button-group">
                    <button class="btn btn-secondary" onclick="importData()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>
                        Import
                    </button>
                    <button class="btn btn-primary" onclick="exportData()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3v-12" />
                        </svg>
                        Export
                    </button>
                </div>
            </div>
        </div>

        <div class="table-wrapper">
            <table id="employeeTable">
                <thead>
                    <tr>
                        <th style="width: 60px;"></th>
                        <th>Employee</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Date Registered</th>
                        <th style="width: 120px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var person in Model.Persons)
                    {
                        <tr>
                            <td>
                                <div class="avatar">
                                    @{
                                        var firstInitial = !string.IsNullOrEmpty(person.Firstname) ? person.Firstname[0] : '-';
                                        var lastInitial = !string.IsNullOrEmpty(person.Lastname) ? person.Lastname[0] : '-';
                                    }
                                    @firstInitial @lastInitial
                                </div>
                            </td>
                            <td>
                                <div class="employee-name">@person.Firstname @person.Lastname</div>
                            </td>
                            <td>
                                <div class="employee-email">@person.Email</div>
                            </td>
                            <td>
                                @{
                                    var status = person.Status == 10 ? "Active" : "Inactive";
                                    var statusClass = person.Status == 10 ? "active" : "inactive";
                                }
                                <span class="badge badge-@statusClass">
                                    <span class="status-dot"></span>
                                    @status
                                </span>
                            </td>
                            <td>@person.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td style="text-align: center;">
                                @{
                                    var isInactive = person.Status == 0;
                                    var buttonText = isInactive ? "Reactivate" : "Delete";
                                    var buttonClass = isInactive ? "btn-reactivate" : "btn-delete";
                                    var action = isInactive ? "reactivate" : "delete";
                                    var confirmMessage = isInactive ? "Are you sure you want to reactivate this employee?" : "Are you sure you want to delete this employee?";
                                }
                                <form method="post" style="display: inline;" onsubmit="return confirm('@confirmMessage');">
                                    <input type="hidden" name="employeeId" value="@person.Id" />
                                    <input type="hidden" name="action" value="@action" />
                                    <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                                    <input type="hidden" name="search" value="@Model.SearchTerm" />
                                    <button type="submit" class="@buttonClass">@buttonText</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="emptyState" class="empty-state" style="display: none;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                </svg>
                <h3>No employees found</h3>
                <p>Try adjusting your search criteria</p>
            </div>
        </div>

        <div class="pagination-wrapper">
            <div class="pagination-info">
                Showing 
                <span id="showingStart">@((Model.CurrentPage - 1) * Model.PageSize + (Model.Persons.Count > 0 ? 1 : 0))</span>-<span id="showingEnd">@((Model.CurrentPage - 1) * Model.PageSize + Model.Persons.Count)</span> 
                of 
                <span id="totalItems">@Model.TotalCount</span> employees
            </div>
            <div class="pagination-controls">
                <a href="@GetPageUrl(Model.CurrentPage - 1)" 
                   class="page-btn" 
                   id="prevBtn" 
                   @(Model.CurrentPage == 1 ? "onclick=\"return false;\" style=\"opacity: 0.4; cursor: not-allowed;\"" : "")>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
                <div id="pageNumbers" style="display: flex; gap: 0.5rem;">
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <a href="@GetPageUrl(i)" class="page-btn @(i == Model.CurrentPage ? "active" : "")">@i</a>
                        }
                    }
                </div>
                <a href="@GetPageUrl(Model.CurrentPage + 1)" 
                   class="page-btn" 
                   id="nextBtn" 
                   @(Model.CurrentPage == Model.TotalPages || Model.TotalPages == 0 ? "onclick=\"return false;\" style=\"opacity: 0.4; cursor: not-allowed;\"" : "")>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</body>

</html>